# ─── API ───────────────────────────────────────────────────────────
# Token que exige la API en cada /api/* (mismo valor en el frontend/Vercel).
API_TOKEN=
# Origen del frontend para CORS (ej: https://tuapp.vercel.app). Opcional.
FRONTEND_ORIGIN=

# ─── Seguridad: cifrado de la clave tributaria guardada ─────────────
# Genera la llave con:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# NO la compartas ni la subas al repo. Sin ella, las claves se guardan en claro.
ENCRYPTION_KEY=

# ─── Anti-bloqueo (segundos entre peticiones) ──────────────────────
# Pausa mínima y máxima aleatoria entre cada request al SII.
SII_DELAY_MIN=2.0
SII_DELAY_MAX=5.0
# Reintentos ante error de red
SII_MAX_RETRIES=3

# ─── Anti-bloqueo por IP: proxy con IP chilena (opcional) ───────────
# Déjalo VACÍO para conexión directa. Ej: http://usuario:clave@host:puerto
SII_PROXY=

# ─── Almacenamiento de documentos (efímero) ────────────────────────
# Carpeta temporal de documentos generados. No es persistente a propósito.
DATA_DIR=./data

# ─── Supabase ──────────────────────────────────────────────────────
# Si defines URL + SERVICE_KEY, las EMPRESAS se guardan en Postgres (producción).
# Si lo dejas vacío, se usa SQLite local. La SERVICE_KEY es secreta: solo backend.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=sii-documentos
