# ─── Credenciales SII ───────────────────────────────────────────
# RUT del contribuyente con guion y dígito verificador (ej: 77271121-2)
SII_RUT=77271121-2
# Clave Tributaria del SII
SII_CLAVE=tu_clave_aqui

# ─── Anti-bloqueo (segundos entre peticiones) ──────────────────────
# Pausa mínima y máxima aleatoria entre cada request al SII.
SII_DELAY_MIN=2.0
SII_DELAY_MAX=5.0
# Reintentos ante error de red
SII_MAX_RETRIES=3

# ─── Almacenamiento ────────────────────────────────────────────────
# Carpeta local donde se guardan documentos (siempre activo)
DATA_DIR=./data

# ─── Supabase (OPCIONAL) ───────────────────────────────────────────
# Déjalo vacío para guardar solo en local.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_BUCKET=sii-documentos
