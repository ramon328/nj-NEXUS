# =====================================================================
# NEXUS — Plantilla de secretos
# Copia a `.env`, rellena valores y:  chmod 600 .env
# NUNCA subas el `.env` real al repo.
# =====================================================================

# --- Anthropic (cerebro) ---
ANTHROPIC_API_KEY=
MODELO_DEFAULT=claude-haiku-4-5
MODELO_ESCALADO=claude-sonnet-4-6
MODELO_EXCEPCIONAL=claude-opus-4-8
MODELO_ASISTENTE=
MODELO_LIVIANO=
MODELO_WEB_ASISTENTE=
MODELO_CONCILIA=
LIMITE_GASTO_MENSUAL_USD=

# --- Supabase (Nexus) ---
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Supabase (otros proyectos, opcionales) ---
SUPABASE_AGENTES_URL=
SUPABASE_AGENTES_ANON_KEY=
SUPABASE_AGENTES_SERVICE_ROLE_KEY=
ALIACE_SUPABASE_URL=
ALIACE_SUPABASE_ANON_KEY=
ALIACE_SUPABASE_SERVICE_KEY=
FORJA_SUPABASE_URL=
FORJA_SUPABASE_ANON_KEY=
EMAILS_SUPABASE_URL=
EMAILS_SUPABASE_SERVICE_KEY=
EMAILS_DATABASE_URL=

# --- Puertos locales ---
PUERTO_HUB=3000
PUERTO_COMISIONES=3001
PUERTO_SII=8000
PUERTO_CEREBRO=8081
PUERTO_OPENCLAW=18789
PUERTO_NAVEGADOR=8082
PUERTO_CENTRO_PUB=7690
RESERVO_PORT=8896
PROXY_CL_PORT=8899
PROXY_GEN_PORT=8890

# --- Bind / host extra (Tailscale IP, opcional) ---
HUB_HOST_EXTRA=

# --- Hermes (policy gate). Values stay local. Never copy production IDs into git. ---
HERMES_TENANT_ID=
HERMES_DATA_DIR=
HERMES_MANIFEST_SECRET=

# --- WhatsApp (Kapso / Meta Cloud API) ---
KAPSO_API_KEY=
KAPSO_PHONE_ID=
KAPSO_WEBHOOK_SECRET=
KAPSO_API_BASE_URL=https://api.kapso.ai
META_GRAPH_VERSION=v24.0
WHATSAPP_NUMERO=
KAPSO_PLANTILLA_ALERTA=alerta_nexus
KAPSO_PLANTILLA_ALERTA_IDIOMA=es
CENTRO_ADMIN_DE=

# --- Twilio (opcional, SMS/voz legacy) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
TWILIO_LANG=
TWILIO_VOICE=

# --- Google (TAG / Gmail, opcional) ---
GOOGLE_API_KEY=
TAG_WEB_CLIENT_ID=
TAG_WEB_CLIENT_SECRET=

# --- Proxies de salida (IP residencial) ---
PROXY_CL_TOKEN=
PROXY_CL_ALLOW=.sii.cl
PROXY_GEN_TOKEN=
PROXY_GEN_ALLOW=*

# --- DuckDNS (opcional) ---
DUCKDNS_DOMAIN=
DUCKDNS_TOKEN=

# --- GoAutos / AutoHighLevel (portal autos; distinto de Aliace) ---
# Anon key es pública (bundle del cliente). Opcional: si no se setean, el código usa el default.
GOAUTOS_SUPABASE_URL=
GOAUTOS_SUPABASE_ANON_KEY=

# --- Aliace / paneles internos ---
ALIACE_URL=
ALIACE_USER=
ALIACE_PASS=
ALIACE_APROBADOR_UUID=

# --- SII ---
SII_API_TOKEN=
SII_BACKEND_URL=
SII_EMISION_HABILITADA=0

# --- Reservo ---
RESERVO_API_TOKEN=
RESERVO_TOKEN=
RESERVO_ESCRITURA=0
RESERVO_PUBLIC_BASE=

# --- Tek / banco (tokens de API local, no claves del banco) ---
TEK_API_TOKEN=
TEK_API_TOKEN_BROWSER=
TEK_SIN_ASISTIDO=1
TEK_ANACLARA_SOLO_RAMON=0
TEK_EMP_FRESH_MIN=
TEK_AUTOFIX=0

# --- Widgets / paneles (tokens locales) ---
WIDGET_TOKEN=
WIDGET_AUTOS_TOKEN=
WIDGET_LEADS_TOKEN=
HOOK_TOKEN=
CLAUDE_WEB_PIN=

# --- Rail / otros (opcionales) ---
RAIL_API_BASE=
RAIL_SECRET_KEY=
NESTOR_OWNER_EMAIL=
PAMELA_WS=
FORJA_URL=https://nicojuri.ai/

# --- Cobranza / WA pacing (opcionales) ---
WA_LOTE=
WA_PAUSA_MIN=
WA_REP_INTERVALO_MIN=
WA_REP_MAX=

# --- Segundo Cerebro (bóveda Obsidian) ---
# CEREBRO_RUTA=

# --- Transcribe / Whisper ---
