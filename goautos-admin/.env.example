# Analytics
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=
VITE_PUBLIC_POSTHOG_HOST=

# Vercel
# El cliente YA NO usa estas vars: la gestión de dominios (subdominios del
# onboarding + dominios propios) pasa por la edge function `vercel-domain`,
# que guarda el token server-side. Configurar como secrets de Supabase:
#   supabase secrets set VERCEL_TOKEN=... VERCEL_PROJECT_ID=... VERCEL_TEAM_ID=...
# (VERCEL_PROJECT_ID debe ser el proyecto que SIRVE los sitios públicos.)

# Mastra AI
VITE_MASTRA_URL=

# Supabase
# IMPORTANT: all domains serving this app must be listed under
# Authentication → URL Configuration → Additional Redirect URLs
# in the Supabase dashboard. Missing entries cause 522/CORS failures
# on /auth/v1/token even when the project is healthy.
# Current allowed origins: http://goauto.cl, https://www.portal.goauto.cl
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Kapso
KAPSO_API_KEY=
KAPSO_BASE_URL=
