# ── Copiá a .env (local) o cargá en Render → Environment ──────────────────────

# Supabase (las mismas del proyecto Autos Intel)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Cerebro IA que redacta/responde (queda en Vercel)
OUTREACH_API_URL=https://autosintel.vercel.app/api/outreach

# 1 = la IA responde sola a quienes ella contactó primero; 0 = solo guarda
WA_AUTO_REPLY=1

# Proxy chilena. Con usuario/clave:  http://usuario:clave@host:puerto
# Si la proxy autoriza por IP (sin clave):  http://host:puerto
PROXY_URL=

# Dónde se guarda la sesión de WhatsApp.
#   Local:  ./.wwebjs_auth
#   Render: /data/.wwebjs_auth  (disco persistente → no re-escanear)
WWEBJS_DATA_PATH=./.wwebjs_auth

# Chrome del sistema. En el Docker de Render ya queda en /usr/bin/chromium.
# En Mac local: /Applications/Google Chrome.app/Contents/MacOS/Google Chrome
CHROME_PATH=

# Opcional: protege la página /qr. Si lo seteás, abrí la URL con ?token=ESE_VALOR
QR_TOKEN=
